{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "ignorePatterns": [
        "dist/",
        "src-tauri/",
        "src-dotnet/",
        "external/",
        "src/pudu/generated/",
        "package-lock.json",
        "react-compiler-bailouts.json"
    ]
}
